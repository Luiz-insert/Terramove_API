# Copie este arquivo para .env e ajuste os valores:  cp .env.example .env
# O .env NÃO deve ser commitado (já está no .gitignore).

# --- MongoDB (container local) ---
MONGO_ROOT_USER=esg_admin
MONGO_ROOT_PASSWORD=troque-esta-senha
MONGO_DATABASE=esg_db
MONGO_PORT=27017

# --- API ---
API_PORT=8080
# vazio = perfil padrão | staging | prod
SPRING_PROFILES_ACTIVE=
APP_ENVIRONMENT=docker-local
# true = limpa e popula o banco com dados de exemplo ao iniciar
APP_SEED_ENABLED=true

# --- Usuários da API (HTTP Basic) ---
APP_ADMIN_PASSWORD=admin123
APP_USER_PASSWORD=user123
